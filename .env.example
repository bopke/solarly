# Copy this file to `.env` (or `.env.local`) and adjust as needed. Vite
# only exposes variables prefixed with `VITE_` to client code — see
# https://vite.dev/guide/env-and-mode.html.

# Contact email sent as the `email` query param on Nominatim geocoding
# requests (src/data-sources/nominatim.ts), per Nominatim's usage policy
# (https://operations.osmfoundation.org/policies/nominatim/). Optional:
# the client already defaults to contact@bopke.dev if this is unset, so
# you only need to set this to use a different contact address (e.g. for
# a fork or a separate deployment). See
# docs/decisions/0050-nominatim-client.md for the full rationale.
VITE_NOMINATIM_CONTACT_EMAIL=contact@bopke.dev

# Mapbox API key used to fetch Mapbox Satellite raster tiles for the scene
# tracing step (src/scene/tracing/), where the user traces roof/ground-array
# outlines over real imagery. REQUIRED for satellite imagery to load — unlike
# every other integration in this project (OpenFreeMap, Nominatim, NASA
# POWER, Open-Meteo), this is the first API-keyed dependency and has no
# sensible built-in default (it's a real credential, not a contact address).
# Get a free key at https://account.mapbox.com/ (Account > Tokens).
#
# If this is unset (or invalid, or the tile request otherwise fails —
# rate limit, network error), the tracing step falls back to the same
# plain MapLibre vector style used elsewhere in the app, with an inline
# notice — the drawing tool itself still works, just without real
# imagery underneath. See docs/superpowers/specs/2026-09-13-solarly-m2-design.md
# ("Error handling") and the scene/tracing module doc comment.
VITE_MAPBOX_API_KEY=
